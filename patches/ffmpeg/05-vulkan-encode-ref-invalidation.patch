+/* The lowest AV1 reference slot not holding a picture that this one
+ * references or keeps in the DPB. */
+static int av1_free_slot(FFHWBaseEncodePicture *pic)
+{
+    uint32_t used = 0;
+
+    for (int i = 0; i < pic->nb_refs[0]; i++)
+        used |= 1 << ((VulkanEncodeAV1Picture *)pic->refs[0][i]->codec_priv)->slot;
+    for (int i = 0; i < pic->nb_dpb_pics; i++) {
+        if (pic->dpb[i] != pic)
+            used |= 1 << ((VulkanEncodeAV1Picture *)pic->dpb[i]->codec_priv)->slot;
+    }
+
+    for (int i = 0; i < AV1_NUM_REF_FRAMES; i++) {
+        if (!(used & (1 << i)))
+            return i;
+    }
+    av_assert0(0);
+    return 0;
+}
