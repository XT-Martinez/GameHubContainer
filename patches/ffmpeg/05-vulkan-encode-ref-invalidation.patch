+// The history holds its pictures with ref_count[1] only: that keeps each
+// picture, but not the pictures it referenced itself.
+static void hw_base_encode_hist_drop(FFHWBaseEncodeContext *ctx, int i)
+{
+    --ctx->hist[i]->ref_count[1];
+    av_assert0(ctx->hist[i]->ref_count[1] >= 0);
+    memmove(&ctx->hist[i], &ctx->hist[i + 1],
+            (ctx->nb_hist - i - 1) * sizeof(*ctx->hist));
+    ctx->hist[--ctx->nb_hist] = NULL;
+}
+
+// Keep the two newest reference pictures and, further back, every fourth
+// one, so that a few DPB slots reach back far enough for a loss report to
+// arrive.  hist[] is ordered oldest first.
+static void hw_base_encode_hist_add(FFHWBaseEncodeContext *ctx,
+                                    FFHWBaseEncodePicture *pic)
+{
+    int i, sparse = FFMAX(ctx->rfi_history - 2, 0);
+
+    if (!ctx->rfi_history)
+        return;
+
+    // Nothing before an intra picture may be referenced after it.
+    if (pic->type == FF_HW_PICTURE_TYPE_IDR ||
+        pic->type == FF_HW_PICTURE_TYPE_I) {
+        while (ctx->nb_hist)
+            hw_base_encode_hist_drop(ctx, 0);
+    }
+
+    ctx->hist[ctx->nb_hist++] = pic;
+    ++pic->ref_count[1];
+
+    for (i = ctx->nb_hist - 1; i >= 0; i--) {
+        int64_t age = pic->display_order - ctx->hist[i]->display_order;
+        if (age < 2)
+            continue;
+        if (ctx->hist[i]->display_order % 4 == 0 && age < 4 * sparse + 2)
+            continue;
+        hw_base_encode_hist_drop(ctx, i);
+    }
+    while (ctx->nb_hist > ctx->rfi_history)
+        hw_base_encode_hist_drop(ctx, 0);
+}
+
+// The decoder lost the pictures from pts first on.  Forget them and return
+// the newest picture before them, which the next picture then references
+// instead of a keyframe, or NULL if none is left.
+static FFHWBaseEncodePicture *hw_base_encode_rfi_anchor(AVCodecContext *avctx,
+                                                        FFHWBaseEncodeContext *ctx,
+                                                        int64_t first)
+{
+    FFHWBaseEncodePicture *anchor;
+    int i;
+
+    for (i = ctx->nb_hist - 1; i >= 0; i--) {
+        if (ctx->hist[i]->pts >= first)
+            hw_base_encode_hist_drop(ctx, i);
+    }
+    if (!ctx->nb_hist) {
+        av_log(avctx, AV_LOG_VERBOSE, "No reference before pts %"PRId64
+               " left, encoding an IDR picture.\n", first);
+        return NULL;
+    }
+
+    anchor = ctx->hist[ctx->nb_hist - 1];
+    av_log(avctx, AV_LOG_VERBOSE, "Invalidating references from pts %"PRId64
+           ", referencing pts %"PRId64".\n", first, anchor->pts);
+
+    for (i = 0; i < ctx->nb_next_prev; i++) {
+        --ctx->next_prev[i]->ref_count[0];
+        ctx->next_prev[i] = NULL;
+    }
+    ctx->next_prev[0] = anchor;
+    ++anchor->ref_count[0];
+    ctx->nb_next_prev = 1;
+
+    return anchor;
+}
