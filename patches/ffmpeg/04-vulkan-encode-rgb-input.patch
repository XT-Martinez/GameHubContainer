+/* Find the first format the device supports for the given usage that maps to
+ * pix_fmt (or, if vk_fmt is set, that equals vk_fmt). */
+static int vulkan_encode_pick_format(AVCodecContext *avctx, FFVulkanEncodeContext *ctx,
+                                     VkImageUsageFlags usage, enum AVPixelFormat pix_fmt,
+                                     VkFormat vk_fmt, VkFormat *out)
+{
+    VkResult ret;
+    FFVulkanFunctions *vk = &ctx->s.vkfn;
+    VkVideoFormatPropertiesKHR *ret_info;
+    uint32_t nb_out_fmts = 0;
+    VkPhysicalDeviceVideoFormatInfoKHR fmt_info = {
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VIDEO_FORMAT_INFO_KHR,
+        .pNext = &ctx->profile_list,
+        .imageUsage = usage,
+    };
+    int i;
+
+    ret = vk->GetPhysicalDeviceVideoFormatPropertiesKHR(ctx->s.hwctx->phys_dev,
+                                                        &fmt_info, &nb_out_fmts, NULL);
+    if (ret == VK_ERROR_FORMAT_NOT_SUPPORTED ||
+        (!nb_out_fmts && ret == VK_SUCCESS)) {
+        return AVERROR(EINVAL);
+    } else if (ret != VK_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "Unable to get Vulkan format properties: %s!\n",
+               ff_vk_ret2str(ret));
+        return AVERROR_EXTERNAL;
+    }
+
+    ret_info = av_mallocz(sizeof(*ret_info)*nb_out_fmts);
+    if (!ret_info)
+        return AVERROR(ENOMEM);
+
+    for (i = 0; i < nb_out_fmts; i++)
+        ret_info[i].sType = VK_STRUCTURE_TYPE_VIDEO_FORMAT_PROPERTIES_KHR;
+
+    ret = vk->GetPhysicalDeviceVideoFormatPropertiesKHR(ctx->s.hwctx->phys_dev,
+                                                        &fmt_info, &nb_out_fmts, ret_info);
+    if (ret != VK_SUCCESS || !nb_out_fmts) {
+        av_free(ret_info);
+        return ret == VK_SUCCESS || ret == VK_ERROR_FORMAT_NOT_SUPPORTED ?
+               AVERROR(EINVAL) : AVERROR_EXTERNAL;
+    }
+
+    av_log(avctx, AV_LOG_VERBOSE, "Supported formats for usage 0x%x:\n", usage);
+    for (i = 0; i < nb_out_fmts; i++)
+        av_log(avctx, AV_LOG_VERBOSE, "    %i: %i\n", i, ret_info[i].format);
+
+    for (i = 0; i < nb_out_fmts; i++) {
+        if (vk_fmt ? ret_info[i].format == vk_fmt :
+                     ff_vk_pix_fmt_from_vkfmt(ret_info[i].format) == pix_fmt) {
+            *out = ret_info[i].format;
+            break;
+        }
+    }
+
+    av_free(ret_info);
+
+    if (i == nb_out_fmts) {
+        av_log(avctx, AV_LOG_ERROR, "Pixel format %s of input frames not supported!\n",
+               av_get_pix_fmt_name(pix_fmt));
+        return AVERROR(EINVAL);
+    }
+
+    return 0;
+}
