+#ifdef VK_VALVE_video_encode_rgb_conversion
+/* Choose the RGB->YCbCr conversion the encoder performs for RGB input,
+ * from the stream's colorspace, range and chroma siting. */
+static int vulkan_encode_init_rgb_conversion(AVCodecContext *avctx,
+                                             FFVulkanEncodeContext *ctx,
+                                             const VkVideoEncodeRgbConversionCapabilitiesVALVE *caps)
+{
+    VkVideoEncodeRgbModelConversionFlagBitsVALVE model;
+    VkVideoEncodeRgbRangeCompressionFlagBitsVALVE range;
+    VkVideoEncodeRgbChromaOffsetFlagBitsVALVE x_off, y_off;
+
+    switch (avctx->colorspace) {
+    case AVCOL_SPC_BT2020_NCL:
+        model = VK_VIDEO_ENCODE_RGB_MODEL_CONVERSION_YCBCR_2020_BIT_VALVE;
+        break;
+    case AVCOL_SPC_BT470BG:
+    case AVCOL_SPC_SMPTE170M:
+        model = VK_VIDEO_ENCODE_RGB_MODEL_CONVERSION_YCBCR_601_BIT_VALVE;
+        break;
+    case AVCOL_SPC_BT709:
+    case AVCOL_SPC_UNSPECIFIED:
+        model = VK_VIDEO_ENCODE_RGB_MODEL_CONVERSION_YCBCR_709_BIT_VALVE;
+        break;
+    default:
+        av_log(avctx, AV_LOG_ERROR, "RGB input: colorspace %s has no "
+               "matching conversion model\n", av_color_space_name(avctx->colorspace));
+        return AVERROR(EINVAL);
+    }
+
+    range = avctx->color_range == AVCOL_RANGE_JPEG ?
+            VK_VIDEO_ENCODE_RGB_RANGE_COMPRESSION_FULL_RANGE_BIT_VALVE :
+            VK_VIDEO_ENCODE_RGB_RANGE_COMPRESSION_NARROW_RANGE_BIT_VALVE;
+
+    /* Chroma is cosited horizontally for both LEFT (MPEG-2, the default)
+     * and TOPLEFT siting; they differ vertically. */
+    x_off = VK_VIDEO_ENCODE_RGB_CHROMA_OFFSET_COSITED_EVEN_BIT_VALVE;
+    y_off = avctx->chroma_sample_location == AVCHROMA_LOC_TOPLEFT ?
+            VK_VIDEO_ENCODE_RGB_CHROMA_OFFSET_COSITED_EVEN_BIT_VALVE :
+            VK_VIDEO_ENCODE_RGB_CHROMA_OFFSET_MIDPOINT_BIT_VALVE;
+    if (!(caps->xChromaOffsets & x_off))
+        x_off = VK_VIDEO_ENCODE_RGB_CHROMA_OFFSET_MIDPOINT_BIT_VALVE;
+    if (!(caps->yChromaOffsets & y_off))
+        y_off = y_off == VK_VIDEO_ENCODE_RGB_CHROMA_OFFSET_MIDPOINT_BIT_VALVE ?
+                VK_VIDEO_ENCODE_RGB_CHROMA_OFFSET_COSITED_EVEN_BIT_VALVE :
+                VK_VIDEO_ENCODE_RGB_CHROMA_OFFSET_MIDPOINT_BIT_VALVE;
+
+    if (!(caps->rgbModels & model) || !(caps->rgbRanges & range) ||
+        !(caps->xChromaOffsets & x_off) || !(caps->yChromaOffsets & y_off)) {
+        av_log(avctx, AV_LOG_ERROR, "RGB input: conversion to %s (%s range) "
+               "is not supported by the device (models 0x%x, ranges 0x%x)\n",
+               av_color_space_name(avctx->colorspace),
+               av_color_range_name(avctx->color_range),
+               caps->rgbModels, caps->rgbRanges);
+        return AVERROR(ENOTSUP);
+    }
+
+    ctx->rgb_session = (VkVideoEncodeSessionRgbConversionCreateInfoVALVE) {
+        .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_SESSION_RGB_CONVERSION_CREATE_INFO_VALVE,
+        .rgbModel = model,
+        .rgbRange = range,
+        .xChromaOffset = x_off,
+        .yChromaOffset = y_off,
+    };
+
+    return 0;
+}
+#endif
