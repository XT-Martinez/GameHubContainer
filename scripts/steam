#!/bin/bash
set -euo pipefail

# Scope the uinput shim to Steam and its descendants so Steam Input virtual
# controllers get tagged for the container without affecting Xwayland.
# Keep the dynamic loader token literal so 32-bit and 64-bit Steam children
# resolve the correct shim variant.
shim='/usr/$LIB/libuinput_shim.so'
if [ -n "${LD_PRELOAD:-}" ]; then
    export LD_PRELOAD="${shim}:${LD_PRELOAD}"
else
    export LD_PRELOAD="${shim}"
fi

# Add the shared library (STEAM_LIBRARY_PATH) to Steam's library list before
# Steam starts; a no-op once registered or while Steam is already running.
/usr/local/bin/register-steam-library || true

# Drop the saved controller mapping that swaps Cross and Circle in the Steam UI.
/usr/local/bin/steam-drop-ps5bind.sh || true

# Use the image's D7VK build for PROTON_USE_D7VK, and give Faugus the
# SteamGridDB key.
/usr/local/bin/sync-d7vk || true
/usr/local/bin/faugus-steamgriddb || true

exec /usr/bin/steam "$@"
