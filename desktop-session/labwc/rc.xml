<?xml version="1.0"?>
<labwc_config>
  <core>
    <gap>8</gap>
  </core>

  <placement>
    <policy>center</policy>
  </placement>

  <windowSwitcher preview="yes" outlines="yes">
    <osd show="yes" style="thumbnail" output="focused" thumbnailLabelFormat="%T" />
  </windowSwitcher>

  <desktops>
    <number>1</number>
  </desktops>

  <theme>
    <name>GameHub</name>
    <icon>GameHub</icon>
    <cornerRadius>10</cornerRadius>
    <keepBorder>yes</keepBorder>
    <dropShadows>yes</dropShadows>
    <dropShadowsOnTiled>no</dropShadowsOnTiled>
    <maximizedDecoration>titlebar</maximizedDecoration>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
    </titlebar>
    <font place="ActiveWindow">
      <name>Inter</name>
      <size>10</size>
      <weight>Bold</weight>
    </font>
    <font place="InactiveWindow">
      <name>Inter</name>
      <size>10</size>
      <weight>Bold</weight>
    </font>
    <font place="MenuHeader">
      <name>Inter</name>
      <size>10</size>
      <weight>Bold</weight>
    </font>
    <font place="MenuItem">
      <name>Inter</name>
      <size>10</size>
    </font>
    <font place="OnScreenDisplay">
      <name>Inter</name>
      <size>10</size>
    </font>
  </theme>

  <!-- Window edges grab 12 px for resizing even though the border is 1 px -->
  <resize>
    <drawContents>yes</drawContents>
    <minimumArea>12</minimumArea>
  </resize>

  <snapping>
    <range inner="10" outer="10" />
    <topMaximize>yes</topMaximize>
  </snapping>

  <menu>
    <showIcons>yes</showIcons>
  </menu>

  <keyboard>
    <default />
    <repeatRate>30</repeatRate>
    <repeatDelay>300</repeatDelay>

    <!-- App launcher (toggle) -->
    <keybind key="W-space">
      <action name="Execute" command="/usr/local/bin/desktop-launcher.sh" />
    </keybind>

    <!-- Desktop menu -->
    <keybind key="W-m">
      <action name="ShowMenu" menu="root-menu" />
    </keybind>

    <!-- Terminal -->
    <keybind key="W-Return">
      <action name="Execute" command="/usr/bin/foot --config=/usr/share/gamehub-desktop/foot/foot.ini" />
    </keybind>

    <!-- File manager -->
    <keybind key="W-e">
      <action name="Execute" command="/usr/bin/thunar" />
    </keybind>

    <!-- Browser -->
    <keybind key="W-b">
      <action name="Execute" command="/usr/bin/firefox" />
    </keybind>

    <!-- Desktop Steam client -->
    <keybind key="W-s">
      <action name="Execute" command="/usr/local/bin/desktop-steam.sh" />
    </keybind>

    <!-- Maximize / tile -->
    <keybind key="W-Up">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" />
    </keybind>

    <!-- Screenshot: area select to clipboard -->
    <keybind key="W-S-s">
      <action name="Execute" command="sh -c 'grim -g &quot;$(slurp)&quot; - | wl-copy'" />
    </keybind>

    <!-- Screenshot: full screen to clipboard -->
    <keybind key="Print">
      <action name="Execute" command="sh -c 'grim - | wl-copy'" />
    </keybind>

    <!-- Return to Steam game mode -->
    <keybind key="W-Escape">
      <action name="Execute" command="/usr/local/bin/return-to-steam.sh" />
    </keybind>
  </keyboard>

  <mouse>
    <default />

    <!-- Desktop: right click opens the menu; left click does nothing -->
    <context name="Root">
      <mousebind button="Left" action="Press">
        <action name="None" />
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
    </context>

    <!-- Alt+drag moves (left) or resizes (right) a window from anywhere in it.
         Super+drag does the same by default, but Moonlight clients often keep
         the Super key for themselves. -->
    <context name="Frame">
      <mousebind button="A-Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="A-Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="A-Right" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="A-Right" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
  </mouse>
</labwc_config>
