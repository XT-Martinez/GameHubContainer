#!/bin/sh

# Match labwc's output to gamescope's *current* resolution.
# SCREEN_WIDTH/SCREEN_HEIGHT hold the original container defaults, but
# set-resolution.sh may have changed gamescope's output when a Moonlight
# client connected (e.g., 2560x1440). Query gamescope directly.
GS_DISPLAY="${GAMESCOPE_WAYLAND_DISPLAY:-gamescope-0}"
GS_RES=$(WAYLAND_DISPLAY="$GS_DISPLAY" wlr-randr 2>/dev/null \
    | grep -oP '\d+x\d+(?= px.*current)' || echo "")

if [ -n "$GS_RES" ]; then
    W="${GS_RES%x*}"
    H="${GS_RES#*x}"
else
    W="${SCREEN_WIDTH:-1920}"
    H="${SCREEN_HEIGHT:-1080}"
fi
wlr-randr --output WL-1 --custom-mode "${W}x${H}" 2>/dev/null &

# Themed configs are rendered by gamehub-theme (see start-desktop-session.sh)
THEMED="${XDG_CONFIG_HOME:-$HOME/.config}/gamehub-desktop"

/usr/local/bin/gamehub-theme wallpaper

mako --config "$THEMED/mako/config" &

waybar -c "$THEMED/waybar/config.jsonc" -s "$THEMED/waybar/style.css" &

/usr/local/bin/gamehub-dock &
