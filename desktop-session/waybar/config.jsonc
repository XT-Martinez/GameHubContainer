{
  "layer": "top",
  "position": "bottom",
  "height": 44,
  "spacing": 8,
  "margin-top": 0,
  "margin-left": 10,
  "margin-right": 10,
  "margin-bottom": 10,
  "modules-left": ["custom/launcher", "wlr/taskbar"],
  "modules-center": [],
  "modules-right": ["tray", "clock", "custom/steam"],
  "custom/launcher": {
    "format": "\u2630  Apps",
    "tooltip": false,
    "on-click": "/usr/local/bin/desktop-launcher.sh"
  },
  "wlr/taskbar": {
    "icon-size": 20,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["wofi", "fuzzel"]
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8
  },
  "clock": {
    "format": "{:%a  %H:%M}",
    "tooltip-format": "{:%Y-%m-%d  %H:%M:%S}"
  },
  "custom/steam": {
    "format": "\u25c0  Steam",
    "tooltip": false,
    "on-click": "/usr/local/bin/return-to-steam.sh"
  }
}
